# Star Office World Configuration
WORLD_NAME="Star Office"
PEER_PORT=19000
MAX_AGENTS=20
STAR_OFFICE_ADMIN_PASS=1234

# Gemini Session Authentication (Personal Account — Zero API Cost)
# Extract __Secure-1PSID (and optionally __Secure-1PSIDTS) from gemini.google.com browser cookies (DevTools -> Application -> Cookies)
GEMINI_AUTH_MODE=session
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=
GEMINI_SESSION_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_CONCURRENT_REQUESTS=1
GEMINI_REQUEST_TIMEOUT=120000
GEMINI_RETRY_ATTEMPTS=3

# Optional: Legacy/External Gemini API Key strictly for AI background generation (leave empty to use bundled pixel-art backgrounds)
GEMINI_API_KEY=
